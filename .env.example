# Discord bot token from Discord Developer Portal.
DISCORD_TOKEN=

# Discord text channel ID where video announcements should be posted.
DISCORD_CHANNEL_ID=

# Comma-separated YouTube channel IDs. Optional if config/channels.json is used.
YOUTUBE_CHANNEL_IDS=

# Optional comma-separated display names matching YOUTUBE_CHANNEL_IDS order.
YOUTUBE_CHANNEL_NAMES=

# Polling interval. 900 = 15 minutes.
CHECK_INTERVAL_SECONDS=900

# Safety valve so a broken/fresh state file does not spam the server.
MAX_POSTS_PER_CHECK=10

# First run seeds existing videos without posting unless this is true.
POST_ON_FIRST_RUN=false
